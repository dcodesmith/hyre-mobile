{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "development"
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "ios": {
        "resourceClass": "medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://hyre-worker-nestjs.fly.dev",
        "EXPO_PUBLIC_TRUSTED_ORIGIN": "https://hyre-worker-nestjs.fly.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "resourceClass": "medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://hyre-worker-nestjs-production.fly.dev",
        "EXPO_PUBLIC_TRUSTED_ORIGIN": "https://hyre-worker-nestjs-production.fly.dev"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6792344648",
        "appleTeamId": "TXUSKCNY9P"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6792344648",
        "appleTeamId": "TXUSKCNY9P"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}

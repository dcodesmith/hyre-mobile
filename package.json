{
  "name": "hyre-mobile",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "prestart:android": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:3000 tcp:3000 || true",
    "start:android": "expo start --dev-client --android --localhost",
    "start:ios": "expo start --dev-client --ios --localhost",
    "prestart:simulators": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:3000 tcp:3000 || true",
    "start:simulators": "node scripts/setup-simulator-env.js && expo start --dev-client --lan",
    "start:phone": "node scripts/setup-simulator-env.js --hosted && expo start --dev-client --lan",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "preandroid:emulator": "pnpm setup:simulator",
    "android:emulator": "expo run:android --device",
    "ios": "expo run:ios",
    "preios:simulator": "pnpm setup:simulator",
    "ios:simulator": "expo run:ios --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node --import ./scripts/register-ts-resolve.mjs --experimental-strip-types --experimental-test-module-mocks --test \"lib/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && expo install --check",
    "start:simulator": "pnpm start:simulators",
    "setup:simulator": "node scripts/setup-simulator-env.js",
    "setup:simulator:hosted": "node scripts/setup-simulator-env.js --hosted"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-assets/slider": "^11.0.12",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.15",
    "@react-navigation/native": "^7.1.33",
    "@rn-primitives/checkbox": "^1.4.0",
    "@rn-primitives/collapsible": "^1.4.0",
    "@rn-primitives/dialog": "^1.4.0",
    "@rn-primitives/label": "^1.4.0",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/select": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.100.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.20",
    "expo": "^55.0.31",
    "expo-blur": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "^55.0.40",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-notifications": "^55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.74.0",
    "react-native": "0.83.10",
    "react-native-css-interop": "^0.2.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-ui-datepicker": "^3.1.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "~0.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "twrnc": "^4.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/react": "~19.2.14",
    "baseline-browser-mapping": "^2.10.24",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "react-native-safe-area-context": "5.6.2"
    }
  }
}
# Origin header for API calls (hyre-worker-nestjs Better Auth; RN does not send Origin).
# Defaults to the same origin as EXPO_PUBLIC_API_BASE_URL (must match a worker TRUSTED_ORIGINS entry).
# EXPO_PUBLIC_TRUSTED_ORIGIN=http://localhost:3000

# API base URL — hyre-worker-nestjs (Nest) default PORT is 3000
# Do NOT use http://0.0.0.0:3000 — 0.0.0.0 is only for the server to listen on, not for clients.
#
# Simulators on this computer use the LOCAL API (localhost:3000) by default:
#   pnpm start:simulators
#   (iOS simulator reaches localhost directly; Android emulator via adb reverse, run automatically)
#
# Physical phone uses the HOSTED dev environment on fly.io:
#   pnpm start:phone
#
# Physical Android over USB against the local API (adb reverse maps phone :3000 → Mac :3000):
#   pnpm start:android   (runs adb reverse for 8081 and 3000)
#   EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Optional: request timeout in milliseconds (default: 10000)
# EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Optional for local development; required by app.config.js for preview and
# production EAS builds. Telemetry remains disabled in development.
# The DSN is a public client key. Keep sendDefaultPii disabled in lib/telemetry.ts.
# EXPO_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# EXPO_PUBLIC_APP_ENV=preview

# Native source-map uploads also require SENTRY_AUTH_TOKEN, SENTRY_ORG, and
# SENTRY_PROJECT as EAS environment variables. Never commit the auth token.
